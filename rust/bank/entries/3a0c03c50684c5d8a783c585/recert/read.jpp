// 第二批 C25 · 下一步做哪个（归类 · K 个字面动作描述，路 B 不声明 over_kind · 语义题式）：取真机读数用于认证。
// 题式带 permute: true（B64）：真机每题发正序、逆序两次，读数取均值。
// 材料经 `jpp run --input input.json` 交入：input.items[i] = {id, text, goal, over}，text 是眼下的情况，id 是不透明编号。
budget {calls: 170, cost: 0.05, depth: 256};

let next_step = form("select", "现在要达成的目标是：{goal}。根据眼下的情况，下面哪一步最该先做？",
    {calib: "cls-next-step", permute: true});

fn one(x) !{judge} {
    let r = judge(state(mat(x.text), {over: x.over}), fill(next_step, {goal: x.goal}));
    handle(cut(r), {
        pick: fn(k) { {id: x.id, key: key_of(r), exit: "pick", open: []} },
        unsure: fn(u) { {id: x.id, key: key_of(r), exit: "unsure", open: [u]} }
    })
}

let rows = map(input.items, fn(x) !{judge} { one(x) });

{rows: map(rows, fn(x) { {id: x.id, key: x.key, exit: x.exit} }),
 pending: fold(rows, [], fn(acc, x) { concat(acc, x.open) })}
