{
 "items": [
  {
   "id": "c00",
   "text": "他在挪威工作过一年，后来被派去了法国。",
   "kind": "国家"
  },
  {
   "id": "c01",
   "text": "会议代表来自巴西和泰国两个国家。",
   "kind": "国家"
  },
  {
   "id": "c02",
   "text": "听说北京最近连着下了一周的雨。",
   "kind": "城市"
  },
  {
   "id": "c03",
   "text": "会议代表来自日本和加拿大两个国家。",
   "kind": "国家"
  },
  {
   "id": "c04",
   "text": "新闻说埃及今年的出口增长很快。",
   "kind": "国家"
  },
  {
   "id": "c05",
   "text": "这批货从上海发出，预计周五能到。",
   "kind": "城市"
  },
  {
   "id": "c06",
   "text": "他在法国读了两年研究生。",
   "kind": "国家"
  },
  {
   "id": "c07",
   "text": "她说埃及的菜比挪威的更合她胃口。",
   "kind": "国家"
  },
  {
   "id": "c08",
   "text": "这家店的招牌菜据说是从广州学来的做法。",
   "kind": "城市"
  },
  {
   "id": "c09",
   "text": "新闻说日本今年的出口增长很快。",
   "kind": "国家"
  },
  {
   "id": "c10",
   "text": "我们先飞泰国，再从那里去日本。",
   "kind": "国家"
  },
  {
   "id": "c11",
   "text": "我在成都买的茶叶，比在武汉买的便宜不少。",
   "kind": "城市"
  },
  {
   "id": "c12",
   "text": "我们公司在广州新开了一个办事处。",
   "kind": "城市"
  },
  {
   "id": "c13",
   "text": "我们先飞意大利，再从那里去埃及。",
   "kind": "国家"
  },
  {
   "id": "c14",
   "text": "项目组一半人在西安，一半人在成都。",
   "kind": "城市"
  },
  {
   "id": "c15",
   "text": "朋友从杭州搬到了广州，说那边机会更多。",
   "kind": "城市"
  },
  {
   "id": "c16",
   "text": "我们公司在北京新开了一个办事处。",
   "kind": "城市"
  },
  {
   "id": "c17",
   "text": "项目组一半人在武汉，一半人在上海。",
   "kind": "城市"
  },
  {
   "id": "c18",
   "text": "我在上海买的茶叶，比在青岛买的便宜不少。",
   "kind": "城市"
  },
  {
   "id": "c19",
   "text": "她的外婆是巴西人。",
   "kind": "国家"
  },
  {
   "id": "c20",
   "text": "展会原计划在西安办，后来改到了广州。",
   "kind": "城市"
  },
  {
   "id": "c21",
   "text": "听说成都最近连着下了一周的雨。",
   "kind": "城市"
  },
  {
   "id": "c22",
   "text": "这批红酒原本从墨西哥进口，今年改成从埃及进。",
   "kind": "国家"
  },
  {
   "id": "c23",
   "text": "这家店的招牌菜据说是从上海学来的做法。",
   "kind": "城市"
  },
  {
   "id": "c24",
   "text": "他在墨西哥工作过一年，后来被派去了巴西。",
   "kind": "国家"
  },
  {
   "id": "c25",
   "text": "他是在广州长大的，说话还带一点口音。",
   "kind": "城市"
  },
  {
   "id": "c26",
   "text": "日本队在昨晚的比赛里赢了。",
   "kind": "国家"
  },
  {
   "id": "c27",
   "text": "他在泰国工作过一年，后来被派去了埃及。",
   "kind": "国家"
  },
  {
   "id": "c28",
   "text": "我先在南京转机，然后去北京待三天。",
   "kind": "城市"
  },
  {
   "id": "c29",
   "text": "我们刚和一家巴西的公司签了合同。",
   "kind": "国家"
  },
  {
   "id": "c30",
   "text": "这款咖啡豆产自巴西，味道偏酸。",
   "kind": "国家"
  },
  {
   "id": "c31",
   "text": "项目组一半人在西安，一半人在广州。",
   "kind": "城市"
  },
  {
   "id": "c32",
   "text": "这款咖啡豆产自法国，味道偏酸。",
   "kind": "国家"
  },
  {
   "id": "c33",
   "text": "这批货从成都发出，预计周五能到。",
   "kind": "城市"
  },
  {
   "id": "c34",
   "text": "上海和杭州这两天都在降温。",
   "kind": "城市"
  },
  {
   "id": "c35",
   "text": "我在广州买的茶叶，比在武汉买的便宜不少。",
   "kind": "城市"
  },
  {
   "id": "c36",
   "text": "下个月我要去上海出差，顺便见几个老同学。",
   "kind": "城市"
  },
  {
   "id": "c37",
   "text": "会议代表来自法国和泰国两个国家。",
   "kind": "国家"
  },
  {
   "id": "c38",
   "text": "北京的地铁早高峰实在太挤了，我今天迟到了十分钟。",
   "kind": "城市"
  },
  {
   "id": "c39",
   "text": "展会原计划在杭州办，后来改到了成都。",
   "kind": "城市"
  },
  {
   "id": "c40",
   "text": "她的外婆是日本人。",
   "kind": "国家"
  },
  {
   "id": "c41",
   "text": "这批货从北京发出，预计周五能到。",
   "kind": "城市"
  },
  {
   "id": "c42",
   "text": "北京和南京这两天都在降温。",
   "kind": "城市"
  },
  {
   "id": "c43",
   "text": "这款咖啡豆产自日本，味道偏酸。",
   "kind": "国家"
  },
  {
   "id": "c44",
   "text": "展会原计划在青岛办，后来改到了北京。",
   "kind": "城市"
  },
  {
   "id": "c45",
   "text": "他是在上海长大的，说话还带一点口音。",
   "kind": "城市"
  },
  {
   "id": "c46",
   "text": "我先在武汉转机，然后去上海待三天。",
   "kind": "城市"
  },
  {
   "id": "c47",
   "text": "她大学毕业后留在了成都，在一家设计公司上班。",
   "kind": "城市"
  },
  {
   "id": "c48",
   "text": "我们公司在成都新开了一个办事处。",
   "kind": "城市"
  },
  {
   "id": "c49",
   "text": "这部纪录片讲的是埃及的历史。",
   "kind": "国家"
  },
  {
   "id": "c50",
   "text": "下个月我要去广州出差，顺便见几个老同学。",
   "kind": "城市"
  },
  {
   "id": "c51",
   "text": "节目组先去了日本，下一站是挪威。",
   "kind": "国家"
  },
  {
   "id": "c52",
   "text": "节目组先去了巴西，下一站是墨西哥。",
   "kind": "国家"
  },
  {
   "id": "c53",
   "text": "埃及队在昨晚的比赛里赢了。",
   "kind": "国家"
  },
  {
   "id": "c54",
   "text": "今年暑假我们打算去巴西旅行。",
   "kind": "国家"
  },
  {
   "id": "c55",
   "text": "他的博士导师是加拿大人，合作者在日本。",
   "kind": "国家"
  },
  {
   "id": "c56",
   "text": "这款咖啡豆产自埃及，味道偏酸。",
   "kind": "国家"
  },
  {
   "id": "c57",
   "text": "她的外婆是法国人。",
   "kind": "国家"
  },
  {
   "id": "c58",
   "text": "项目组一半人在青岛，一半人在北京。",
   "kind": "城市"
  },
  {
   "id": "c59",
   "text": "她说巴西的菜比墨西哥的更合她胃口。",
   "kind": "国家"
  },
  {
   "id": "c60",
   "text": "他的博士导师是墨西哥人，合作者在法国。",
   "kind": "国家"
  },
  {
   "id": "c61",
   "text": "今年暑假我们打算去法国旅行。",
   "kind": "国家"
  },
  {
   "id": "c62",
   "text": "她说法国的菜比泰国的更合她胃口。",
   "kind": "国家"
  },
  {
   "id": "c63",
   "text": "朋友从南京搬到了成都，说那边机会更多。",
   "kind": "城市"
  }
 ],
