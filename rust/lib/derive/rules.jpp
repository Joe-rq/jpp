// 出题守则（B45、B5；步 28，过程记录 工程-步28.md）：带版本的字面量材料。
//
// 确定性派生的题面模板、唤出提示词、验题闸门的阻断码表都在这一份里，两条出题路用同一套守则（功能二，
// 核心讨论 R3-1）。改这里任何一处都要改 version：本文件随 lib_version 进账本头（裁定十五），题面一变就是
// 新 form_hash、新校准条目，重认由此自然覆盖（B45）。
//
// 唤出提示词按裁定四的十个模块组织：材料、谓词、切法、请求、前提、语境、参照、预算、拿不准去向、完成条件。
// 模块清单的增减归 B0478。
//
// 模板里的写法已按 jpp-check 的静态诊断词面核过（过程记录 §8.3）：每道是非题只有一处「是否」，
// 不用「并且 / 而且 / 既…又」、排除词、「提到」类词与元题词。

// 十个模块的逐项守则（两条唤出入口共用一份：出口入口与目的入口，Z0511）
fn derive_module_rules() {
    "出题守则，按十个模块逐项想："
        + "材料——只问面前这份材料里能看到的东西；"
        + "谓词——一道题只判一件事，不要把两个条件连在一起，也不要问「这份材料有没有帮助判断」这类关于判断本身的题；"
        + "切法——是非题问能答是或否的事，K 选一给出互不重叠的候选；"
        + "请求——说清要选一个还是全部；"
        + "前提——题默认成立的事写进 presupposition；"
        + "语境——需要的背景写进题面，不指望读题的人自己补；"
        + "参照——比较时写明和什么比，要对照参照材料才能判的写 evidence；"
        + "预算——判断很便宜，能判的都出成题，不为省调用合并或删掉有用的题；"
        + "拿不准去向——这道题判不下来时程序会把它细化成更字面的子题、问缺哪类信息补上再判、或带原因转交，"
        + "所以题面要写清判断依据落在材料的哪一部分，拿不准时最该补的是哪类信息；"
        + "完成条件——每道题的答案都要让原题的可能答案变少。"
}

fn derive_rules() { {
    version: "derive-22",

    // 拿不准时可能缺的信息类别（裁定五十一）：按派生类型给，写进派生题式的 lacks，默认链的第二级候选。
    // 类别用守则模块的词；改这里要改 version
    // process：过程入口的动作题（Z0913，裁定七十四 ①）多一类「中间判断」——取法由语言给：派子题 S 先判一件更小的事，
    // 用它的回答缩小候选再问（lib/derive/drive.jpp、运行时默认链）；只在过程入口开
    lacks: {process: ["材料", "语境", "参照", "中间判断"], premise: ["材料", "语境"], degree: ["参照", "材料"], choice: ["材料", "参照"],
            fill: ["材料", "语境"], elicit: ["材料", "语境", "参照"], modules: ["材料", "语境", "参照"]},

    // 先选后填：填一个空的 K 选一。{模板} 里的空写成「___」
    fill_text: fn(template, slot) {
        "就这份材料来说，「" + template + "」里的空（" + slot + "）填哪一项最贴切？"
    },

    // 先选后填：签名没有题式时（参数本身就是追问），题面由已决的块起头（裁定十九：是非题判出哪块即选中哪块）
    lead_block: fn(question, block) { "已判「" + question + "」为" + (if block == "act" { "是" } else { "否" }) + "；" },
    lead_pick: fn(name) { "已选「" + name + "」；" },
    pick_text: fn(lead, slot) { lead + "就这份材料来说，" + slot + "最可能是哪一项？" },

    // 划分细化 · 程度类：m 档拆成 m−1 道「是否至少达到第 j 档」
    degree_text: fn(question, bin) { "「" + question + "」的答案是否至少达到「" + bin + "」？" },

    // 划分细化 · 归类 / 比较 / 决定类：K 个候选拆成 K 道「这一项是不是答案」
    choice_text: fn(question, cand) { "「" + question + "」的答案是否是「" + cand + "」？" },

    // 前提反面：问前提本身，否定作显式候选（Bromberger；B155 答案标签）
    premise_text: fn(p) { "是否" + p + "？" },
    premise_labels: fn(p) { {yes: p, no: "并非：" + p} },
    // 前提被判不成立时，原题的答案块
    premise_failed: "前提不成立",

    // 唤出提示词（后备路）。模型按 JSON 列表输出候选题
    elicit_prompt: fn(question, cause) {
        "下面这道题判不下来（原因：" + cause + "）：「" + question + "」。"
        + "请提出更字面、更容易从材料里直接判断的下一道题，写成 JSON 对象，一个候选一个对象："
        + "{\"op\": \"test\" 或 \"select\", \"text\": 题面, \"over\": [候选…]（select 才有）, "
        + "\"presupposition\": 前提（可省）, \"evidence\": [要用到的参照槽，如 \"ref\"]（可省）, "
        + "\"request\": 请求（可省；是非题 \"whether\"，K 选一 \"one\"）}。题面里不要用花括号。"
        + derive_module_rules()
    },

    // ———— 目的入口（Z0511，裁定六十三）：目的 → 抽模块 → 补模块 → 查题库 → 唤出 → 组装 ————
    // 抽模块：一次生成，与材料项个数无关；shape 是材料的顶层字段名（从数据读出，没有时为空）
    purpose_prompt: fn(purpose, shape) {
        "下面是一段目的：「" + purpose + "」。"
        + "要判断的材料是一批同样形状的条目"
        + (if len(shape) == 0 { "（每条是一段文字）" } else { "（每条的字段：" + join(shape, "、") + "）" })
        + "，每条可能还带一份参照材料。请把这段目的拆成出题守则的十个模块，写成一个 JSON 对象："
        + "{\"material\": 被判断的对象与参照各指什么, \"predicates\": [{\"text\": 要对每个条目判断的事, "
        + "\"cut\": \"binary\" 或 \"k_ary\" 或 \"ordered\", \"over\": [候选…]（k_ary 才有）, "
        + "\"scale\": [从低到高的档…]（ordered 才有）, \"request\": \"one\" 或 \"all\", "
        + "\"cut_from\", \"over_from\", \"scale_from\": 各自是 \"purpose\"（目的原文说了）或 \"system\"（目的没说、你补的）, "
        + "\"field\": 这件事的答案在结果里的名字（短的英文小写）}], \"request\": 请求, \"presupposition\": 前提, "
        + "\"context\": 语境, \"reference\": 参照, \"budget\": 预算, \"unsure\": 拿不准去向, "
        + "\"done\": [结果里每个条目要有的字段名]}。"
        + "目的里没说的模块写 null，不要替目的补。"
        + "谓词——目的要对每个条目判断几件事就写几个，一个谓词一件事；"
        + "切法——判是否用 binary；从几个互不重叠的候选里挑一个用 k_ary；排先后、分高低用 ordered；"
        + "候选与档位——目的里列了就照抄并标 purpose；目的没列时可以给出（k_ary 给互不重叠的候选，ordered 给三到五档），但要标 system，"
        + "切法同理；"
        + "请求——每个条目给一个答案写 one，要全部满足的写 all；"
        + "完成条件——目的要求结果里有什么，就在 done 里列什么，每个名字对应一个谓词的 field。"
    },
    // 唤出（目的入口）：为一个没命中题库的谓词出题。modules 是抽出的模块（JSON 文字）
    purpose_elicit_prompt: fn(modules, pred, cut_name) {
        "下面是从一段目的里拆出的模块：" + modules + "。"
        + "请为其中这个谓词出一道交给判断器的题：「" + pred + "」（切法：" + cut_name + "）。"
        + "题会对每个条目各问一次，条目在材料里，参照材料（若有）在参照槽 ref。"
        + "写成 JSON 对象，一个候选一个对象："
        + "{\"op\": \"test\" 或 \"select\" 或 \"measure\", \"text\": 题面, \"over\": [候选…]（select 才有）, "
        + "\"scale\": [从低到高的档…]（measure 才有）, \"presupposition\": 前提（可省）, "
        + "\"evidence\": [要用到的参照槽，如 \"ref\"]（可省）, "
        + "\"request\": 这道题的请求（可省；是非题 \"whether\"，K 选一 \"one\"，程度题 \"degree\"；"
        + "与上面模块里谓词的 one / all 不是一回事，那是每个条目要几个答案）}。题面里不要用花括号。"
        + derive_module_rules()
    },
    // 补模块：目的没说的模块由系统补什么（来源记 system），今天补不上的记 missing 并写明归哪一条
    purpose_fill: {presupposition: "premise-derive:B0470", context: "", reference: "ref", budget: "program-budget",
                   unsure: "default-chain:Z0398"},
    // 前提（B0470）：目的没说前提时由系统派生字面前提题，交给 select.jpp 筛材料——判过线的才纳入深判。
    // 字面前提题问材料本身写明了什么，不问「这段材料对判断有没有帮助」那类元题（09：P7、#17、E-ENOUGH）。
    // 一次生成，与材料项个数无关；最多取 premise_max 道（每多一道，最多多一轮「每项一次」的判断）
    premise_max: 2,
    // 哪类入口派生前提（裁定七十五）：只有批量入口（purpose_run）派生；过程入口（purpose_plan / purpose_drive）不派生。
    // 依裁定七十一，前提只管「材料能不能回答这个目的」；过程入口每步的材料是世界按契约交回的整份观测，可判性由契约保证
    // （缺的只会是 done 或空观测，走世界契约，不走前提），派出来的「材料里写明了某物吗」都是证据；候选每步才由世界给，
    // 派生时拿不到，不成立时也没有可接的去处。按入口类型定，与任务无关
    premise_process: false,
    // 提示里的「至多两道」与 premise_max 一致，改一处要改另一处
    // Z0860（裁定六十八第①条）：shape 是字段名，samples 是等距抽取的几条记录取值（②），dropped 是上一轮没有区分度、被弃的前提，
    // evidence 是上一轮按「前提≠证据」弃掉的（derive-15，主会话 2026-10-02：前提与结果无关，不成立时目的仍能用某个候选作答的是证据）
    // cands 是目的各个 K 选一谓词的候选原文（derive-16：每道前提附 if_false，主控 2026-10-02 定；
    // derive-17：if_false 写成结构；derive-18：目的无法作答那一种改名 unanswerable，与候选同名的兜底分开，主会话 2026-10-02 裁定）
    premise_prompt: fn(purpose, preds, shape, samples, dropped, evidence, cands) {
        "下面是一段目的：「" + purpose + "」。要对一批条目逐个判断：" + join(preds, "；") + "。"
        + "在细判之前，先用字面前提题筛掉不值得细判的条目：每道题问条目材料本身写明了什么（例如「材料里写明了某件事吗？」），"
        + "条目不满足它，就不必为这个目的再细判。不要问「这段材料对判断有没有帮助」「材料够不够判断」这类关于判断本身的题。"
        + "前提必须与结果无关：不管各道题最后判成哪个答案，判断要成立都得先满足它。若一道前提不成立时目的仍能用某个候选作答，"
        + "它就是那个答案的证据，不是前提，不要写。"
        + "判前提题时只看得到这一个条目自己的材料，看不到参照材料、用户，也看不到目的里提到的其他输入；"
        + "所以题面只问条目自己写明了什么，不要提参照、用户，也不要写「对照」「相符」「匹配」这类要拿别的材料比着才能答的说法。"
        + (if len(shape) == 0 { "" } else { "条目是结构化记录，字段：" + join(shape, "、") + "。" })
        + (if len(samples) == 0 { "" } else { "下面是从这批条目里等距取出的几条（只作参考，不代表全部）：" + join(samples, "；") + "。" })
        + "每道前提应当让一部分条目满足、一部分不满足；照样本看全都满足或全都不满足的，不要写。"
        + "只看某个字段的取值就能定的（字段有没有、是否等于某值、数值大小、列表里有没有某一项、文字里有没有某段字），"
        + "写成代码谓词 {\"op\": \"code\", \"field\": 字段名, \"check\": \"has\" 或 \"eq\" 或 \"ne\" 或 \"lt\" 或 \"le\" 或 \"gt\" 或 \"ge\" 或 \"contains\", \"value\": 值（has 不要）, \"if_false\": 见下}，"
        + "由代码判，不交给判断器；要理解意思才能定的，写成是非题 {\"op\": \"test\", \"text\": 题面, \"if_false\": 见下}。"
        + "每道都要写 if_false：这道前提不成立时，目的会落到哪个候选。"
        + (if len(cands) == 0 { "目的没有列出候选，if_false 一律写 {\"falls_to\": \"unanswerable\"}。" }
           else { "落到某个候选就写 {\"falls_to\": \"candidate\", \"value\": 候选原文}，候选原文照下列逐字抄一个（"
                  + join(map(cands, fn(c) { "「" + c + "」" }), "") + "），它是那个答案的证据，会被弃掉；"
                  + "不成立时材料不够判、目的无法作答，写 {\"falls_to\": \"unanswerable\"}。"
                  + "表示「都不合适、不选任何一类」的兜底候选不是落点：那是材料够、判过之后的结果，不是材料不够判。" })
        + (if len(dropped) == 0 { "" } else { "下面这些前提在样本上没有区分度（全部满足或全部不满足），换别的：" + join(dropped, "；") + "。" })
        + (if len(evidence) == 0 { "" } else { "下面这些在样本上的分法与某个候选一致，是那个答案的证据、不是前提，换别的：" + join(evidence, "；") + "。" })
        + "写出至多两道，按筛掉条目的多少从多到少排，一道一个 JSON 对象。题面里不要用花括号。"
    },
    // 代码谓词的检查（Z0860 ①）：has 字段在且非空；eq / ne 取值相等 / 不等；lt / le / gt / ge 数值比较；
    // contains 列表里有一项等于值、或文字里含这段字
    code_checks: ["has", "eq", "ne", "lt", "le", "gt", "ge", "contains"],
    // 样本（Z0860 ②③）：给生成器看 premise_sample_k 条取值，每条截到 premise_value_chars 字；
    // 抽样检验 n = max(premise_sample_min, ⌈premise_sample_pct% · N⌉)，不超过 N；派生至多 premise_rounds 轮
    premise_sample_k: 5,
    premise_value_chars: 300,
    premise_sample_min: 20,
    premise_sample_pct: 5,
    premise_rounds: 2,
    // 前提≠证据（derive-15）：样本上有候选标签可比时，前提分出的满足 / 不满足两组与某个候选分出的是 / 不是这一类两组一致，
    // 即 evidence_not_premise 弃掉；两组各至少 premise_evidence_min_side 项已决且有标签才比
    premise_evidence_min_side: 2,
    // 查题库：谓词与已认证题式是不是同一件事（K 选一，候选是题式题面加「都不是」）
    // 完成条件列了、谓词没覆盖的字段：补一个谓词（Z0535），走同一条查题库 → 唤出的路
    purpose_missing_field: fn(f) { "目的要求结果里有「" + f + "」这一项：就每个条目给出这一项的答案" },
    // 补出的谓词切法未知时唤出提示里的写法（Z0559）
    purpose_cut_unknown: "未定（按题意出是非、K 选一或程度题）",
    // 完成条件里的字段是不是某个已有谓词换了个名字（Z0559）
    purpose_alias_text: "结果里要的这一项，和下列哪一件要判断的事说的是同一件事？",
    bank_match_text: "这段话要判断的事，和下列哪一道已认证的题问的是同一件事？",
    bank_none: "都不是",

    // ———— 作者入口（B0478，功能一）：作者填模块，题库没命中时按切法把谓词组装成题面 ————
    // 题面只由谓词与切法组成；材料、参照、语境、候选进状态槽，档位、前提、证据槽、拿不准缺哪类进题式声明，
    // 所以同一谓词在不同背景下是同一个题式（校准挂题式，R2-3）
    assemble_text: fn(cut_name, pred) {
        if cut_name == "k_ary" { "就这份材料来说，" + pred + "是下列哪一项？" }
        else if cut_name == "ordered" { "就这份材料来说，" + pred + "落在哪一档？" }
        else { "就这份材料来说，是否" + pred + "？" }
    },
    // 作者入口补模块时与 purpose_fill 不同的项：前提派生（B0470）要吃目的原文，作者入口没有，
    // 作者没填前提就不派生、不筛材料（B0478 rebase，复核要求）
    author_fill: {presupposition: "not-derived"},

    // 验题闸门第①段的阻断码：派生题命中即不发出（只作用于派生题，作者手写的题照旧只得到提示，意图汇编 11a）。
    // 码名与 jpp-check 静态诊断的 W-diag-* 对齐（主控答复：阻断表放在这里）。
    block_codes: ["W-diag-exclusion", "W-diag-two-judgments", "W-diag-open-question", "W-diag-meta",
                  "W-diag-mention-scope", "W-diag-abstract-direct", "W-diag-fill"],

    // ———— 过程入口（Z0886，第三靶子预注册 §2.2）：世界接口每步要一个动作，系统补一个动作谓词 ————
    // 候选来自过程（over_from: process），每步由世界给；谓词按守则组装（assemble_text 的 K 选一），不唤出
    purpose_act_pred: fn(purpose) { "为了「" + purpose + "」，下一步最该做的动作" },
    purpose_act_field: "act",

    // ———— 题树沿出口（Z0913，第三靶子第三圈预注册 §2；裁定七十二 (3)、七十四）：动作题拿不准、走到「中间判断」时 ————
    // 子题 S 的谓词：出题时与别的谓词一起唤出、过闸门（K 选一，候选「要紧的事」由生成器给，不是作者写的意图表，B2-1）；
    // 不逐步判，只挂在动作题上，默认链走到中间判断时才问
    tree_s_pred: fn(purpose) { "为了「" + purpose + "」，眼下最要紧的是哪一件事（从几件互不重叠的要紧的事里选一件）" },
    tree_s_field: "tree_s",
    // 子题 S 唤出时另给的输入（第三圈 Z0913 预注册 §2.1：目的、动作题题面、候选的形状——开局那一拍世界给的动作名单样例）；
    // 不含逐步的材料
    tree_s_hint: fn(act_q, actions) {
        "这个谓词是动作题「" + act_q + "」拿不准时先判的一件更小的事；动作题每一步的候选由世界给，开局那一步的候选是："
        + actions + "。要紧的事比单个动作粗一层，几件之间互不重叠，每件都能用来判断某个动作是不是在做它。"
    },
    // 缩小：对每个动作候选问一道是非题，同一状态、同一题式填不同的候选（R-102 同层一次发出）；去掉带外判否的，带内保留
    tree_narrow_template: "就这份材料来说，下一步做「{动作}」是在做「{要紧的事}」这件事吗？",
    // 再问动作题时进 ctx 的那一条：S 问了什么（{q}）、答了哪一件（{s}）；运行时代入
    tree_ctx: "先判了一件更小的事：「{q}」，答的是「{s}」",

    // ———— 计分途径进过程入口（第三靶子第四圈预注册 §2.1；Jpp 10-02；代码复核 M1 照实写）————
    // 过程入口里与「完成条件」有关的有两样，并存、互不读取：
    //   ① modules.done：抽模块给的「结果里要有的字段」，谓词没覆盖的由 purpose_head 补成字段谓词（Z0535、Z0559）——
    //      与批量入口（purpose_run）同一份行为，第三圈起过程入口就有，照旧；
    //   ② done.routes：这一局怎么计分——出题时从目的与规则材料另行派生几条计分途径（drive.jpp 的 purpose_done，不读 modules.done），
    //      作动作题的一份语境（开关 done）、并作带计分途径的子题 S′ 的唤出输入。
    // 两者要不要同源（同一个模块的两种读法）留作下一圈交 Jpp 的设计题，这一圈不动。
    // 规则材料出题时经程序的 unsure_source 按这一类取一次（库内部 unsure_fetch），程序不改；取不到时计分途径留空、原因进明细
    done_source: "语境",
    // 派生提示：输入只有目的、开局观测的字段名；规则原文作生成器的材料（gen 的 ctx），不拼进提示，也不含逐步材料。
    // 第五圈（预注册 §2.1）：每条途径同时给出可达条件——什么时候计、拿到它要先满足的前提、代价，各摘一句原文作出处；
    // 一次派生，对照臂只用途径本身（route），途径带可达条件的臂用整条
    done_prompt: fn(purpose, shape) {
        "下面是一段目的：「" + purpose + "」。这是一个按步推进的过程"
        + (if len(shape) == 0 { "" } else { "，每一步的观测有这些字段：" + join(shape, "、") })
        + "。材料里是这个过程的规则原文。请从规则原文里找出这一局怎么计分，也就是目的的完成条件："
        + "列出几条计分途径；每条写成一个对象：{\"route\": 一句短话，写明做什么、得几分（原文没写分值就不写分值）, "
        + "\"when\": 什么时候计（原文没写就给空文本）, \"needs\": [拿到它要先满足的前提…], \"cost\": 要付出的代价（原文没写就给空文本）, "
        + "\"from\": 摘一句规则原文作出处}。途径与可达条件只写规则原文里写了的、或由原文直接推出的，不推测。"
        + "写成一个 JSON 对象：{\"routes\": [计分途径…]}。"
    },
    // 动作题语境里的那一份（开关 done 为 on 时每拍都在）
    done_ctx: fn(routes) { "这一局怎么计分：" + join(routes, "；") },
    // 带完成条件的子题 S′（4.d 用；4.z、4.e 用照第三圈办法的 S）：谓词另一句，唤出提示在 S 的补充之后再加完成条件，规则原文作材料
    tree_s_pred_done: fn(purpose) { "为了「" + purpose + "」，照这一局的计分办法，眼下最要紧的是哪一件事（从几件互不重叠的要紧的事里选一件）" },
    tree_s_done_field: "tree_s_done",
    tree_s_hint_done: fn(routes) {
        "这一局怎么计分（从规则原文派生的完成条件）：" + join(routes, "；")
        + "。规则原文在材料里。要紧的事从目的、这一局怎么计分与规则原文来定。"
    },

    // ———— 计分途径带可达条件（第三靶子第五圈预注册 §2.1，臂 5.p；开关 reach）————
    // 一条途径带可达条件的写法（进动作题语境、进 S″ 的唤出补充）；空的条件写「原文没写」
    reach_text: fn(r) {
        r.route + "（什么时候计：" + (if r.when == "" { "原文没写" } else { r.when })
        + "；要先满足：" + (if len(r.needs) == 0 { "原文没写" } else { join(r.needs, "、") })
        + "；代价：" + (if r.cost == "" { "原文没写" } else { r.cost }) + "）"
    },
    // 动作题语境里的那一份（reach 为 on 时代替 done_ctx）
    reach_ctx: fn(text) { "这一局怎么计分（每条带拿到它要满足什么）：" + text },
    // 子题 S″：候选是带前提的途径，题问以眼前的处境哪条拿得到；谓词另一句，唤出提示在 S 的补充之后加带可达条件的途径，规则原文作材料
    tree_s_pred_reach: fn(purpose) { "为了「" + purpose + "」，以现在的处境，眼下最要紧的是拿哪一条计分途径（从各带前提的途径里选一条拿得到的）" },
    tree_s_reach_field: "tree_s_reach",
    tree_s_hint_reach: fn(text) {
        "这一局的计分途径与拿到各条要满足什么（从规则原文派生）：" + text
        + "。规则原文在材料里。候选就是这些途径（相近的可以合并），每个候选写明它的前提；题问的是以眼前这份材料里的处境，哪条途径拿得到。"
    },
    // S″ 候选的归属由生成器标注（预注册 §2.1，第四圈教训：二元组规则鉴别力弱）：出题时 S″ 定下之后标一次
    reach_label_prompt: fn(numbered, over) {
        "下面是这一局的计分途径（从 1 起编号）：" + numbered + "。下面是一道题的候选：" + over + "。"
        + "请给每个候选标上它对应第几条计分途径；一个候选对应不上任何一条的标 0。"
        + "写成一个 JSON 对象：{\"labels\": [每个候选一个整数，顺序同候选]}。"
    }
} }
