// 判出来的图 + 图算法（B148 搭配层，步 25d）：JEV 判边，图算法在判出来的图上跑，数值产物给区间。
//
// 边有三种状态：已决有（edges）、已决无（rejected）、未决（pending）。算法只在已决边上跑；未决边另跑一次
// 「乐观图」（已决 ∪ 未决），两次产物之差由 differs 标出——那几条就是该先问人的边。
// 数字不流：读数不作边权、不进算法；算法只吃已决与未决两组边（权默认 1，调用者可给非判断来源的权）。
// 每个函数的输入输出都是普通值与契约值，产物元素带 item，可再交给 sieve、pair，或作下一张图的节点。
//
// 依据：B148（12 §2.3、§5 搭配层行）；21 步 25d；比赛/附注-2026-09-25-搭配层设计与36小时施工.md §三·3.3、§三·5；
// 动作契约见 crates/jpp/src/actions/graph.rs。产物出口 = compose(所用边出口, "all")，误差界由 compose 累加、cert 读出
// （B161），库不自己加 α。differs 非空时，乐观产物与 interval 的 exit 必然未决、不放行不可逆动作：所用边只有
// act 与未决两种，all 合成遇未决即未决（compose 语义蕴含，compose_graph.rs 有测试）。已知缺口（过程记录/工程-步25d.md）：
// 分组类算法（k 人一队）没有动作（graph:partition_k，24e-3）。

// 材料或元素（带 item 的记录）统一取材料：借 pair 的元素识别，不需要类型判别
fn graph_materials(xs) { map(pair(map(xs, fn(x) { [x, x] })).value, fn(r) { r.item.a }) }

// 未决里「没观察到」的那一类（与 lib/outcome.jpp 的 unobserved_cause 同一集合，B95）
fn graph_unobserved(c) { c == "absent" || c == "budget" || c == "depth" || c == "latency" || c == "deadline" }

// 候选下标对判边，组成图。ij 是 [[i, j]]，left/right 是两端的节点列表，off 是右端节点号的偏移；
// opts.line（B128 补齐）原样交给判边的 sieve，只在给了时才传选项（不给线的程序与改前相同，旧二进制照样能跑）
fn graph_judge(nodes, n_left, left, right, ij, off, edge_q, opts) -> Record<Exit> {
    let rels = pair(map(ij, fn(p) { [left[p[0]], right[p[1]]] })).value;
    // ends：两端节点号；eid：候选序号（判后 value 与 pending 各自重排位置，用 eid 认边）
    let cands = map(rels, fn(r) { with(with(r, "ends", [ij[r.pos][0], off + ij[r.pos][1]]), "eid", r.pos) });
    let o = if has(opts, "line") { sieve(cands, edge_q, {line: opts.line}) } else { sieve(cands, edge_q) };
    {kind: "graph", nodes: nodes, n_left: n_left,
     edges: o.value, rejected: o.detail.ignore, pending: o.pending,
     unobserved: filter(o.pending, fn(p) { graph_unobserved(p.cause) }),
     judged: o, spent: o.spent}
}

// 单集合、无向：候选取 i < j；opts.prune(nodes) 给下标对时只判这些；opts.over(a, b) 给时按它筛
fn judged_graph(nodes, edge_q, opts) -> Record<Exit> {
    let n = len(nodes);
    let ij = if has(opts, "prune") { opts.prune(nodes) } else {
        fold(range(0, n), [], fn(acc, i) {
            concat(acc, map(filter(range(0, n), fn(j) {
                i < j && (!has(opts, "over") || opts.over(nodes[i], nodes[j]))
            }), fn(j) { [i, j] }))
        })
    };
    graph_judge(nodes, unit, nodes, nodes, ij, 0, edge_q, opts)
}

// 二部图：左右两组节点，右侧节点号从 len(left) 起；opts.prune(left, right) 给 [[i, j]]（i 在左、j 在右）
fn judged_bipartite(left, right, edge_q, opts) -> Record<Exit> {
    let nl = len(left);
    let ij = if has(opts, "prune") { opts.prune(left, right) } else {
        fold(range(0, nl), [], fn(acc, i) {
            concat(acc, map(filter(range(0, len(right)), fn(j) {
                !has(opts, "over") || opts.over(left[i], right[j])
            }), fn(j) { [i, j] }))
        })
    };
    graph_judge(concat(left, right), nl, left, right, ij, nl, edge_q, opts)
}

// 节点号的文字形（动作把节点号一律转成文字）还原成节点号
fn graph_node_no(g, s) { filter(range(0, len(g.nodes)), fn(i) { text(i) == s })[0] }

// 交给动作的输入：边行 + 按算法补的字段
fn graph_input(g, algo, args, rows) {
    let ids = range(0, len(g.nodes));
    if algo == "matching" {
        let base = {edges: rows, nodes: ids};
        let b = if g.n_left == unit { base } else {
            with(with(base, "bipartite", true), "parts", [slice(ids, 0, g.n_left), slice(ids, g.n_left, len(ids))])
        };
        if has(args, "size") { with(b, "size", args.size) } else { b }
    } else {
        if algo == "shortest_path" {
            {edges: rows, nodes: ids, source: args.source, target: args.target,
             directed: has(args, "directed") && args.directed}
        } else {
            if algo == "max_clique" || algo == "components" { {edges: rows, nodes: ids} } else {
                fail(join(["on_graph 只接 matching、shortest_path、max_clique、components；", algo,
                           " 不是在边上跑的形状（set_cover、max_flow 请直接 do）"], ""))
            }
        }
    }
}

// 一个产物：所用边（在 used 里的下标）与成员节点号 → 元素，出口 = compose(所用边出口, "all")（B131、B161）。
// 用到未决边的产物出口未决，并吸收那几条边的责任；同一条边在 g.pending 里的那份是同一责任的另一个视图（B162）
fn graph_product(g, used, idx, members, pair_item) -> Record<Exit> {
    let es = map(idx, fn(k) { used[k] });
    let item = if pair_item { es[0].item } else { {members: graph_materials(map(members, fn(i) { g.nodes[i] }))} };
    {item: item, trail: [], members: members, nodes: map(members, fn(i) { g.nodes[i] }),
     edges: es, exit: compose(map(es, fn(e) { e.exit }), "all")}
}

// 算法产物 → 元素列表
fn graph_products(g, algo, used, out) -> List<Record<Exit>> {
    if algo == "matching" {
        map(out.pairs, fn(p) { graph_product(g, used, [p.edge_index],
                                             [graph_node_no(g, p.u), graph_node_no(g, p.v)], true) })
    } else {
        if algo == "shortest_path" {
            if out.reachable {
                [graph_product(g, used, map(out.path_edges, fn(x) { x.edge_index }),
                               map(out.path, fn(s) { graph_node_no(g, s) }), false)]
            } else { [] }
        } else {
            if algo == "max_clique" {
                [graph_product(g, used, out.edge_indices, map(out.clique, fn(s) { graph_node_no(g, s) }), false)]
            } else {
                map(out.components, fn(c) {
                    let ms = map(c, fn(s) { graph_node_no(g, s) });
                    graph_product(g, used, filter(range(0, len(used)), fn(k) { contains(ms, used[k].ends[0]) }), ms, false)
                })
            }
        }
    }
}

// 在图上跑一个算法。mode = "decided" 只用已决边；"optimistic" 用已决 ∪ 未决。
// args：算法参数（matching: size；shortest_path: source、target、directed，节点号即 g.nodes 的下标），
// 以及可选的 weight: fn(边) -> 数（非判断来源的权；缺省 1）。
// 算法没跑成（不支持的算法、预算不够时 do 的失败值，B93）：返回空产物，detail.failed 带失败值，不中止程序
fn on_graph(g, algo, args, mode) -> Record<Exit> {
    let used = if mode == "decided" { g.edges } else { concat(g.edges, g.pending) };
    let rows = map(used, fn(e) {
        {u: e.ends[0], v: e.ends[1], w: if has(args, "weight") { args.weight(e) } else { 1 }}
    });
    let input = graph_input(g, algo, args, rows);
    let r = if is_fail(input) { input } else {
        do(join(["graph:", algo], ""), [input], if mode == "decided" { 0 } else { 1 })
    };
    if is_fail(r) {
        outcome({value: [], detail: {algo: algo, mode: mode, failed: r, edges_used: len(used)}})
    } else {
        let out = content(r);
        let ps = graph_products(g, algo, used, out);
        outcome({value: filter(ps, fn(p) { exit_kind(p.exit) == "act" }),
                 pending: filter(ps, fn(p) { exit_kind(p.exit) != "act" }),
                 detail: {algo: algo, mode: mode, result: out, edges_used: len(used)}})
    }
}

// 一个算法结果里全部并列解用到的边下标（used 里的下标）：动作报的 ties 每项与主解同形（C-8）。
// components 的划分唯一，没有并列；没有 ties 字段的结果（旧动作、没跑成）算空。
fn graph_tie_edges(algo, out) {
    if !has(out, "ties") { [] } else {
        fold(out.ties, [], fn(acc, t) {
            concat(acc, if algo == "matching" { map(t.pairs, fn(p) { p.edge_index }) } else {
                if algo == "shortest_path" { map(t.path_edges, fn(x) { x.edge_index }) } else {
                    if algo == "max_clique" { t.edge_indices } else { [] }
                }
            })
        })
    }
}

// 动作报的并列个数：没跑成或没有 tie_count 字段算 0
fn graph_tie_count(d) {
    if has(d, "result") && has(d.result, "tie_count") { d.result.tie_count } else { 0 }
}

// 动作报的 ties 是否列全：没跑成或没有该字段按列全算（没有并列可漏）
fn graph_ties_complete(d) {
    if has(d, "result") && has(d.result, "ties_complete") { d.result.ties_complete } else { true }
}

// 区间：已决图与乐观图各跑一次。differs = 乐观产物用到的未决边（已决产物按定义不用未决边），
// 并列的最优解（同样好的另一个团、另一条最短路、另一组匹配）用到的未决边也算进去——只看主解会漏掉它们，
// same 会误报为真（案例 01 第 3 条，C-8）。
// complete：两次都跑成；same：跑成、并列都列全、且 differs 为空，即结论不依赖未决边。并列没列全（并列超过动作的枚举
// 上限 64，或 set_cover 走贪心）时 differs 只看得到被列出的并列解，可能漏掉只出现在没列出的并列解里的未决边，
// 所以 same 不判真（复核 Z0173-Z0174 缺口 1，Z0205）：为假的意思是「无法证明不依赖」，不是「依赖」；
// 读 ties_complete 可分辨原因，differs 为空而 same 为假就是这一种。
// unique：两次的最优解都唯一且动作把并列列全了；tie_count_lo / tie_count_hi 是两次各有几个并列最优解，
// ties_complete 是两次的并列都列全了（动作有枚举上限，超过时为假）。
// exit = 乐观产物出口的 compose(…, "all")；alpha_bound、n_unknown 取 cert(exit)（B161 联合界：所用边证书 α 之和封顶 1，
// 无证书的边按 1 计并计入 n_unknown）
fn interval(g, algo, args) -> Record<Exit> {
    let lo = on_graph(g, algo, args, "decided");
    let hi = on_graph(g, algo, args, "optimistic");
    let open0 = fold(concat(hi.value, hi.pending), [], fn(acc, p) {
        concat(acc, filter(map(p.edges, fn(e) { e.eid }), fn(k) { !contains(acc, k) }))
    });
    let used_hi = concat(g.edges, g.pending);
    let tie_idx = if has(hi.detail, "result") { graph_tie_edges(algo, hi.detail.result) } else { [] };
    let open = fold(tie_idx, open0, fn(acc, k) {
        if contains(acc, used_hi[k].eid) { acc } else { append(acc, used_hi[k].eid) }
    });
    let differs = filter(g.pending, fn(e) { contains(open, e.eid) });
    let complete = !has(lo.detail, "failed") && !has(hi.detail, "failed");
    let x = compose(map(concat(hi.value, hi.pending), fn(p) { p.exit }), "all");
    let c = cert(x);
    let n_lo = graph_tie_count(lo.detail);
    let n_hi = graph_tie_count(hi.detail);
    let full = graph_ties_complete(lo.detail) && graph_ties_complete(hi.detail);
    {lo: lo, hi: hi, exit: x, differs: differs, complete: complete, same: complete && full && len(differs) == 0,
     unique: complete && full && n_lo <= 1 && n_hi <= 1, tie_count_lo: n_lo, tie_count_hi: n_hi, ties_complete: full,
     alpha_bound: c.alpha_bound, n_unknown: c.n_unknown}
}
