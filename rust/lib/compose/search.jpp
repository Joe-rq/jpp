// 搜索（B148，步 25c）：提出 → 接地 → 判 → 再提出，JEV 与生成器的搭配。
//
// search(seed, propose, feasible, objective, rounds, opts) -> 契约值
//   seed      第一轮前沿（材料列表）
//   propose   fn(前沿: [Mat], 轮次: Int) -> [Mat]，通常包 gen；返回 Fail 时这一轮零候选、记一条 Unsure(fail)。
//             失败后前沿不变，重提时要换 gen 的 retry_seq（传轮次即可），否则同键重放同一个 Fail
//   feasible  是非题：候选在可行域里吗
//   objective 是非题（候选够好吗）、打分题（measure：候选有多好，只排序，见下文「打分路径」）或 unit（只按可行域筛）
//   rounds    轮数上限（iterate 的 bound；写字面量，静态检查在调用点核，B111）
//   opts      {width: Int, unsure_to?: "carry" | "refine" | fn([未决元素], 题) -> [未决元素], ground?: fn(Mat) -> Mat,
//              rank?: {stat?, tie?}, keep?: fn(Mat) -> Bool}
//             ground 要返回材料（mat）；返回记录会被 sieve 当成元素；rank 原样交给 order，只对打分题目标有效，
//             是非题或 unit 目标上给了即报错（报文带 E-search-options）
//
// opts.keep（判断分工定律谓词半的库落点，B181/B184）：代码谓词，在 ground 之后、feasible 之前对每个
// 新候选求值，假即排除——不是出口也不是未决，不进 sieve、不花调用、不进 pending；接地失败的材料（Fail）
// 不受 keep 拦截，原样交给 sieve（sieve 自己把 Fail 转成 Unsure(fail)）。排除记 detail.excluded：
// [{item: 材料, round: 轮次}]，跨轮累积。unsure_to 为 refine 时，本轮排除的材料并进下一轮前沿——它们和
// 判过拿不准的材料一样是生成器该看到的反馈（未决在前、排除在后）；carry 下排除只记录，不进前沿。
// 好候选按轮累积（主会话 2026-09-26，Q10）：pool 是至今判好的元素（按材料哈希去重、按第一次判好的先后排，
// 每个元素的 round 是它第一次判好的轮次）。每轮：候选去重 → ground（给了才接）→ sieve(可行域) →
// sieve(目标，给了才判) → 新判好的追加进 pool → 下一轮前沿 = pool 的前 width 个的材料。判过的候选
// （按材料哈希，生成的候选即内容哈希）再次提出时不再判、不花钱，按原出口计（好的已在 pool，被拒与未决的
// 已在 ignored 与 pending），计入 duplicates；本轮内的重复同样处理。被拒的进 ignored，未决的按 unsure_to
// 处置、不静默丢，并进 pending 时 via 记 "search#<轮次>"：
//   carry  未决元素经 carry 并进 pending（缺省）；
//   refine 同 carry，另把未决的材料并进下一轮前沿，让生成器据此提更好的候选（出口照样进 pending，
//          不因细化销账；生成器原样重提它时按重复处理，所以每份材料至多判一次）；第一个没失败的轮次
//          结束时 pool 仍为空，不算停滞，至少给细化一轮机会；
//   函数   未决逐个交给它（可行域的配可行域题，目标的配目标题），它返回的元素并进 pending。
//          交人用 lib/compose/ask.jpp 的 ask_human（程序的 budget 要写 escalate: N；没人答时挂起）。
// 终止走 iterate 的线：pool 凑够 width 个即 stop；一轮没有新的好候选（只有重提的旧候选也算）即 noshrink；
// 轮数用尽即 bound。失败的轮次与 refine 的第一轮空 pool 不算停滞：
// 停滞度 = max(width − len(pool), 0) × (rounds + 1) − fails − grace，减掉的数跨不过一档。
// 返回契约值：value 是 pool 的前 width 个（是非题目标下好候选之间没有高下，按判好的先后取），
// 每个元素带 round，出口是 trail 上全部出口的 compose(…, "all")，误差界用 cert(出口) 读；
// detail 带 ignore、rounds、reason、measures、fails、duplicates。
//
// 打分路径（objective 是 measure，步 25c-2，B148、B167）：打分题只排序、不过滤、不 cut——可行的候选都进 pool，
// 每个新进池的候选判一次打分题，读数与 pool 平行存放；每轮按 order(读数们, opts.rank) 排（缺省按档位，
// {stat: "expect"} 按期望档位），逐档展开、档内先进池的在前，取前 width 个为前沿与 value（最好的在前）。
// 进展 = 前 width 个里进了本轮新进池的候选；与末位并列的新候选挤不掉旧的。打分题没有「凑够」，
// 所以不走 stop，只有 noshrink（一轮没有进展）与 bound：停滞度 = (rounds + 1) − gains − fails − grace。
// value 元素的出口只合成可行域那道题（打分题不产生出口）。
// 已知缺口（过程记录 工程-步25c-2.md）：打分路径没有「前 width 个都在最高档即停」的 stop 线。
import "../outcome.jpp";
import "carry.jpp";

fn search(seed, propose, feasible, objective, rounds, opts) {
    let width = opts.width;
    let how = if has(opts, "unsure_to") { opts.unsure_to } else { "carry" };
    let grounded = fn(cands) { if has(opts, "ground") { map(cands, opts.ground) } else { cands } };
    let keep = if has(opts, "keep") { opts.keep } else { fn(m) { true } };
    // 去重：判过的与本轮前面出现过的不再判；返回 {seen, fresh, dups}
    let dedupe = fn(acc, raw) {
        fold(raw, {seen: acc.seen, fresh: [], dups: 0}, fn(st, m) {
            if contains(st.seen, m.hash) { with(st, "dups", st.dups + 1) } else {
                {seen: append(st.seen, m.hash), fresh: append(st.fresh, m), dups: st.dups}
            }
        })
    };
    // 本轮未决与本轮被 keep 排除的去向；返回 {extra: 并进下一轮前沿的材料, pending}
    let settle = fn(acc, from_ok, from_obj, i, excluded) {
        let label = "search#" + text(i);
        if how == "carry" || how == "refine" {
            let now = concat(from_ok, from_obj);
            // 前沿只收材料：未决元素里 item 本身是 Fail（接地失败、无渲染）的不进前沿，仍留在 pending
            // 里（Unsure(fail)，J-05 未决转交，不因不进前沿而销账）。未决材料在前、代码排除的材料在后
            // （未决是判断器已经看过的反馈，排除是纯代码结构判定，B184）
            let refine_now = filter(now, fn(p) { !is_fail(p.item) });
            {extra: if how == "refine" { concat(map(refine_now, fn(p) { p.item }), excluded) } else { [] },
             pending: carry(acc.pending, now, label)}
        } else {
            {extra: [],
             pending: carry(acc.pending, concat(how(from_ok, feasible), how(from_obj, objective)), label)}
        }
    };
    let front = fn(pool) { slice(pool, 0, min(width, len(pool))) };
    // 打分路径（步 25c-2）：objective 是打分题时只排序
    let scored = if objective == unit { false } else { objective.op == "measure" };
    // rank 只对打分题目标有效，给错不静默忽略（Q3）。.jpp 没有作者可抛的带编号错误，取一个以原因命名的
    // 不存在字段，运行期报 E-rt-field，原因与修法原样在报文里（过程记录 工程-步25c-2.md 三、Q4）
    if has(opts, "rank") && !scored {
        opts["E-search-options: rank 只对打分题目标有效（objective 是是非题或 unit 时没有可排序的读数）。修法：去掉 rank，或把 objective 换成 measure 题"]
    } else { unit };
    // 读数们排名后的前 width 个下标（逐档展开，档内按下标升序）
    let rank_top = fn(scores) {
        let tiers = if has(opts, "rank") { order(scores, opts.rank) } else { order(scores) };
        let ranked = fold(tiers, [], fn(a, t) { concat(a, t) });
        slice(ranked, 0, min(width, len(ranked)))
    };
    let step = fn(acc, i) {
        let raw = propose(acc.frontier, i);
        if is_fail(raw) {
            // 失败的一轮 = 零候选 + 一条 Unsure(fail) 上传（主会话 2026-09-26）；前沿与 pool 不变
            let lost = {item: raw, exit: unsure("fail"), cause: "fail", round: i, trail: []};
            with(with(acc, "pending", carry(acc.pending, [lost], "search#" + text(i))), "fails", acc.fails + 1)
        } else {
            let d = dedupe(acc, raw);
            let gd = grounded(d.fresh);
            // 判断分工定律谓词半（B181/B184）：代码已能判定「不可行」的候选在这里排除，不进 sieve。
            // 接地失败的（is_fail）不受 keep 拦截，原样交给 sieve——sieve 已有的机制把它转成 Unsure(fail)
            let excluded = filter(gd, fn(c) { !is_fail(c) && !keep(c) });
            let kept = filter(gd, fn(c) { is_fail(c) || keep(c) });
            let ok = sieve(kept, feasible);
            let has_obj = objective != unit && !scored;
            let by_obj = if has_obj { sieve(accepted(ok), objective) } else { ok };
            let fresh_good = map(accepted(by_obj), fn(e) { with(e, "round", i) });
            let pool = concat(acc.pool, fresh_good);
            // 打分路径：新进池的各判一次打分题，读数与 pool 平行；排名取前 width 个
            let scores = if scored && len(fresh_good) > 0 {
                concat(acc.scores, judge(map(fresh_good, fn(e) { state(e.item) }), objective))
            } else { acc.scores };
            let top = if scored { rank_top(scores) } else { [] };
            let gained = scored && len(filter(top, fn(k) { k >= len(acc.pool) })) > 0;
            let chosen = if scored { map(top, fn(k) { pool[k] }) } else { front(pool) };
            let dropped = if has_obj { concat(ignored(ok), ignored(by_obj)) } else { ignored(ok) };
            let s = settle(acc, ok.pending, if has_obj { by_obj.pending } else { [] }, i, excluded);
            // refine 的第一个没失败的轮次结束时 pool 仍为空：不算停滞（主会话 2026-09-26，Q4）
            let grace = if how == "refine" && acc.judged == 0 && len(pool) == 0 { 1 } else { acc.grace };
            let next = {frontier: concat(map(chosen, fn(e) { e.item }), s.extra), pool: pool,
                        ignored: concat(acc.ignored, dropped), pending: s.pending,
                        fails: acc.fails, grace: grace, judged: acc.judged + 1,
                        seen: d.seen, dups: acc.dups + d.dups,
                        scores: scores, chosen: chosen, gains: if gained { acc.gains + 1 } else { acc.gains },
                        excluded: concat(acc.excluded, map(excluded, fn(c) { {item: c, round: i} }))};
            if !scored && len(pool) >= width { stop(next) } else { next }
        }
    };
    let stall = fn(acc) {
        if scored { rounds + 1 - acc.gains - acc.fails - acc.grace }
        else { max(width - len(acc.pool), 0) * (rounds + 1) - acc.fails - acc.grace }
    };
    let r = iterate(rounds,
                    {frontier: seed, pool: [], ignored: [], pending: [],
                     fails: 0, grace: 0, judged: 0, seen: [], dups: 0,
                     scores: [], chosen: [], gains: 0, excluded: []},
                    step, stall);
    let last = r.value;
    // 元素出口 = trail 上全部出口的 compose(…, "all")（B148；25d 开放 compose）；未决元素保留自己的出口
    let value = map(last.chosen, fn(e) { with(e, "exit", compose(append(e.trail, e.exit), "all")) });
    outcome({value: value, pending: last.pending, evidence: r.evidence, resume: r.resume,
             detail: {ignore: last.ignored, rounds: r.resume.rounds, reason: r.resume.reason,
                      measures: r.resume.measures, fails: last.fails, duplicates: last.dups,
                      excluded: last.excluded}})
}
