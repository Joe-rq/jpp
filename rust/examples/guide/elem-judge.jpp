// 元素：一次判断（judge + cut + handle）。这是 J++ 里最小的搭配单元：一道题问在一份材料上，
// 读数经 cut 按线切成三值出口，handle 把三个出口分派到三段代码。这里的线来自夹具的固定观察记录
// （夹具线，等级 Fixture：照常路由，但按 B29 不算放行不可逆 do 的可信合取项——不等同于经真值样本
// 认证的正式线，只是测试用的固定观察）。真实项目里除了认证线，作者也可以直接在 cut 上写声明线
// cut(r, {declare: {hi, lo?}})——零标注、按写的数执行、不替换、不平移；只有要语言替作者担保一条
// 错误率时才需要标注、走 calib-import 认证（B128/B130，见 elem-declare-stat.jpp、
// elem-declare-accept.jpp）。这道题要理解语义才能判：客户在抱怨、还是在明确要求退款，材料里两者
// 混在一起，不是关键词匹配能分的（意图汇编 7a：字面可算的事——相等、数值比较、格式、是否为空——
// 不该占这个位置，早先这里问的是「已过去 9 小时、约定 4 小时，是否超时」，纯算术，已改成下面这条）。
budget {calls: 4, cost: 0.01, depth: 8};
let refund_ask = test("这条客户留言是不是在明确要求退款？", "customer-refund-request");
let r = judge(state(mat("这台空气净化器用了不到一周就一直报警，联系客服说要寄回厂家检测，我等不及了，东西你们拿回去，钱退给我就行。")), refund_ask);
handle(cut(r), {
    act: fn() { "退款：升级处理" },
    ignore: fn() { "非退款请求" },
    unsure: fn(u) { consume(u, "drop"); "线附近，转人工" }})
