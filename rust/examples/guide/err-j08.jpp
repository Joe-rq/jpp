// 错误示例：J-08（静态子面）。只在宿主开 --guard 时报：`jpp check examples/guide/err-j08.jpp --guard`——
// 不可逆的 write_json 的守卫只来自作者声明线，宿主又没带 --release-on-declared。不带 --guard 是默认
// （相信判断器，意图汇编 11a），检查不报，run 在 act 出口真把 out.json 写进当前目录。
budget {calls: 4, cost: 0.01, depth: 8};
let refund = test("是否要退款？", "j08-demo");
handle(cut(judge(state(mat("对话记录")), refund), {declare: {hi: 0.7, lo: 0.3}}), {
    act: fn() { content(do("write_json", ["out.json", {ok: true}], 0)) },
    ignore: fn() { "不退" },
    unsure: fn(u) { consume(u, "drop"); "转人工" }})
