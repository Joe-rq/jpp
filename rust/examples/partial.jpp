// Algorithms and continuation are source methods, not hidden domain solvers.
budget {calls: 6, cost: 0, depth: 256};
fn observe(m: Mat, q: Question) -> Record !{judge} {
    let exit = cut(judge(state(m), q));
    let result = handle(exit, {
        act: fn() { {resolved: true, value: true} },
        ignore: fn() { {resolved: true, value: false} },
        unsure: fn(cause) { {resolved: false, value: unit, cause: cause} }
    });
    {resolved: result.resolved, value: result.value, exit: exit, material: m,
     question: q, id: m.hash + "|" + text(q)}
}
fn resolved(o) -> Bool { o.resolved }
fn answer(o) -> Bool { if o.resolved { o.value } else { pending("answer is unresolved") } }
fn observation_id(o) -> Text { o.id }
fn accepted(item: Record) -> Bool {
    if resolved(item.observation) { answer(item.observation) } else { false }
}

fn inspect(candidate: Record) -> Record !{do} {
    let valid = candidate.cost > 0 && len(candidate.skills) > 0;
    content(do("record_check", [{name: candidate.name, cost: candidate.cost, skills: candidate.skills, valid: valid}], 0))
}

fn read(candidate: Record) -> Record !{judge} {
    let m = mat(candidate);
    {candidate: candidate, material: m, observation: observe(m, test("Candidate fits?", "fixture"))}
}

fn validate(candidates: List<Record>) -> Record !{judge, do} {
    let items = map(candidates, read);
    let checked = map(filter(items, accepted), fn(item: Record) -> Record !{do} { inspect(item.candidate) });
    {items: items, checked: checked, evidence: map(items, fn(item: Record) { item.observation })}
}

// Power set and constraint selection are written in the language.
fn combinations(candidates: List<Record>) -> List<List<Record>> {
    fold(candidates, [[]], fn(groups, candidate) {
        concat(groups, map(groups, fn(group) { append(group, candidate) }))
    })
}

fn cost(group) -> Int { fold(group, 0, fn(total, candidate) { total + candidate.cost }) }
fn has_skill(group, skill: Text) -> Bool {
    fold(group, false, fn(found, candidate) { found || contains(candidate.skills, skill) })
}
fn feasible(group) -> Bool { cost(group) <= 10 && has_skill(group, "web") && has_skill(group, "database") }

fn plans(s: Record) -> Record {
    let choices = filter(combinations(filter(s.checked, fn(c) { c.valid })), feasible);
    let cheapest = fold(choices, {members: [], cost: 999}, fn(best, group) {
        if cost(group) < best.cost { {members: map(group, fn(c) { c.name }), cost: cost(group)} } else { best }
    });
    {choices: choices, cheapest: cheapest}
}

fn unresolved_items(s: Record) { filter(s.items, fn(item) { !resolved(item.observation) }) }

fn advance(s: Record, strategy) -> Record !{judge, do} {
    let changed = map(s.items, fn(item) !{judge} {
        if !resolved(item.observation) && strategy(item) {
            let c = item.candidate;
            let revised = {name: c.name, cost: c.cost, skills: c.skills, flag: c.name == "C", revision: 1};
            let m = transform(fn(old) { revised }, item.material);
            {candidate: revised, material: m, observation: observe(m, test("Candidate fits?", "fixture"))}
        } else { item }
    });
    let old_names = map(s.checked, fn(c) { c.name });
    let newly_accepted = filter(changed, fn(item) { accepted(item) && !contains(old_names, item.candidate.name) });
    let new_checks = map(newly_accepted, fn(item) !{do} { inspect(item.candidate) });
    let old_ids = map(s.evidence, fn(o) { observation_id(o) });
    let new_evidence = filter(map(changed, fn(item) { item.observation }), fn(o) { !contains(old_ids, observation_id(o)) });
    {items: changed, checked: concat(s.checked, new_checks), evidence: concat(s.evidence, new_evidence)}
}

// One reusable partial-result constructor captures a method and algorithm state.
fn packet(current, project, remaining, next) -> Record {
    {value: project(current), pending: remaining(current), evidence: current.evidence,
     continuation: if len(remaining(current)) == 0 { unit } else {
         fn(strategy) { packet(next(current, strategy), project, remaining, next) }
     }}
}
fn promising(item) -> Bool { item.candidate.cost <= 2 }
fn everything(item) -> Bool { true }
fn enough(value) -> Bool { len(value.choices) > 0 }

let initial = packet(validate([
    {name: "A", cost: 4, skills: ["web"], flag: true, revision: 0},
    {name: "B", cost: 5, skills: ["database"], flag: true, revision: 0},
    {name: "C", cost: 2, skills: ["web", "database"], flag: unit, revision: 0},
    {name: "D", cost: 20, skills: ["web"], flag: unit, revision: 0}
]), plans, unresolved_items, advance);
let used = if enough(initial.value) { initial.value.cheapest } else { unit };
let improved = initial.continuation(promising);
let completed = improved.continuation(everything);
fn snapshot(p) -> Record {
    {best: p.value.cheapest, pending: map(p.pending, fn(item) { item.candidate.name }),
     evidence: p.evidence}
}
{used_before_complete: used, initial: snapshot(initial), improved: snapshot(improved),
 final: snapshot(completed), terminal: len(completed.pending) == 0}
