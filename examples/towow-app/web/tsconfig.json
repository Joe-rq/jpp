{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": false,
    "skipLibCheck": true,
    "types": ["node"],
    "isolatedModules": true,
    "noEmit": true
  },
  "include": ["src", "scripts", "vite.config.ts"]
}
